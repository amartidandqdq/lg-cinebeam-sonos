# Copy to ~/sonos-watcher/watcher.env (read by the systemd unit)
LG_HOST=192.168.1.2
# Sonos Bluetooth address (the Arc Ultra uses its Wi-Fi MAC). Required.
SONOS_BT=aa:bb:cc:dd:ee:ff
# Optional: remote keys of the fallback menu path, comma separated
#MENU_KEYS=DOWN,ENTER,RIGHT,DOWN,ENTER,DOWN,DOWN,ENTER,RIGHT,ENTER,DOWN,ENTER,DOWN,ENTER
# Optional: seconds to wait after power-on
#WARMUP=25

# Optional aggressive recovery after ambiguous short interruptions (default off)
#AUTO_RECOVER_BLIPS=0
# Optional: reconnect when the BT route falls back to the projector speaker while it stays on
# (Bluetooth-only setups; undoes a manual switch to the projector speaker). Default off.
#AUTO_RECOVER_DROPS=0

# Required TLS policy: verify a SHA256 certificate fingerprint locally, then set it.
#TLS_FINGERPRINT=
# Or explicitly accept the trusted-home-LAN compromise (default is 0):
#ALLOW_INSECURE_TLS=1
#STABILITY_SECONDS=10
# Menu fallback is opt-in, only for the measured layout:
#MENU_FALLBACK=1
#MENU_PROFILE=hu710qke-webos24

# Root transport (read-only: A2DP link status and uptime over SSH).
# auto = probe on startup and at each power-on, degrade silently to SSAP;
# ssap = never use SSH; root = same as auto but expects the key to exist.
#ROOT_MODE=auto
#ROOT_SSH_KEY=/home/you/.ssh/id_ed25519
# Host keys are pinned on first connection to this file (accept-new); a key
# change then becomes a hard error instead of a silent prompt.
#ROOT_KNOWN_HOSTS=/home/you/.ssh/known_hosts.cinebeam
# Seconds between A2DP link reads while the BT route is selected (20-600).
#LINK_POLL=60
