# Copy to ~/sonos-watcher/watcher.env (read by the systemd unit)
LG_HOST=192.168.1.2
# Sonos Bluetooth address (the Arc Ultra uses its Wi-Fi MAC). Required.
SONOS_BT=aa:bb:cc:dd:ee:ff
# Optional: remote keys of the fallback menu path, comma separated
#MENU_KEYS=DOWN,ENTER,RIGHT,DOWN,ENTER,DOWN,DOWN,ENTER,RIGHT,ENTER,DOWN,ENTER,DOWN,ENTER
# Optional: seconds to wait after power-on
#WARMUP=25

# Optional aggressive recovery after ambiguous short interruptions (default off)
#AUTO_RECOVER_BLIPS=0

# Required TLS policy: verify a SHA256 certificate fingerprint locally, then set it.
#TLS_FINGERPRINT=
# Or explicitly accept the trusted-home-LAN compromise (default is 0):
#ALLOW_INSECURE_TLS=1
#STABILITY_SECONDS=10
# Menu fallback is opt-in, only for the measured layout:
#MENU_FALLBACK=1
#MENU_PROFILE=hu710qke-webos24
