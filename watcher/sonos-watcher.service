[Unit]
Description=Watcher Sonos CineBeam - reconnexion BT automatique
After=network-online.target

[Service]
ExecStart=%h/.venvs/sonos-watcher/bin/python %h/sonos-watcher/sonos-watcher.py
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
EnvironmentFile=%h/sonos-watcher/watcher.env

[Install]
WantedBy=default.target
